{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [
      "node",
      "@webgpu/types"
    ],
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "packages",
    "outDir": "dist"
  },
  "include": [
    "packages/sdk-core/**/*.ts",
    "packages/sdk-browser/**/*.ts",
    "packages/sdk-node/**/*.mjs"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.mjs",
    "**/target/**"
  ]
}
