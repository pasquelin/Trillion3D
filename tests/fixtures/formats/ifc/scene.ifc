#6=IFCPROJECT('0000000000000000000001',$,'Source fixture',$,$,$,$,(#3),#5);
#7=IFCLOCALPLACEMENT($,#2);
#8=IFCCARTESIANPOINT((2000.,0.,0.));
#9=IFCAXIS2PLACEMENT3D(#8,$,$);
#10=IFCLOCALPLACEMENT(#7,#9);
#20=IFCCARTESIANPOINTLIST3D(((0.,0.,0.),(1000.,0.,0.),(0.,1000.,0.),(0.,0.,1000.)));
#21=IFCTRIANGULATEDFACESET(#20,$,.T.,((1,3,2),(1,2,4),(2,3,4),(3,1,4)),$);
#22=IFCSHAPEREPRESENTATION(#3,'Body','Tessellation',(#21));
#23=IFCPRODUCTDEFINITIONSHAPE($,$,(#22));
#24=IFCBUILDINGELEMENTPROXY('0000000000000000000002',$,'Tetrahedron A',$,$,#7,#23,$,.NOTDEFINED.);
#25=IFCBUILDINGELEMENTPROXY('0000000000000000000003',$,'Tetrahedron B',$,$,#10,#23,$,.NOTDEFINED.);
#30=IFCRECTANGLEPROFILEDEF(.AREA.,'Rectangle',$,1000.,2000.);
#31=IFCDIRECTION((0.,0.,1.));
#32=IFCEXTRUDEDAREASOLID(#30,#2,#31,3000.);
#33=IFCSHAPEREPRESENTATION(#3,'Body','SweptSolid',(#32));
#34=IFCPRODUCTDEFINITIONSHAPE($,$,(#33));
#35=IFCWALL('0000000000000000000004',$,'Extruded wall',$,$,#7,#34,$,.NOTDEFINED.);
#40=IFCCOLOURRGB($,1.,0.,0.);
#41=IFCSURFACESTYLESHADING(#40,0.);
#42=IFCSURFACESTYLE('red-a',.BOTH.,(#41));
#43=IFCSURFACESTYLE('red-b',.BOTH.,(#41));
#44=IFCSTYLEDITEM(#21,(#42),$);
#45=IFCSTYLEDITEM(#32,(#43),$);
ENDSEC;
