# Files written by a tool or a third party, never by hand: GitHub folds them in a diff, and the
# pull request size gate (scripts/check-pr-size.ts) leaves them out of the count. Keep the bare
# form, not `=true`: git's `attr:` pathspec matches only a set attribute.
pnpm-lock.yaml linguist-generated
**/Cargo.lock linguist-generated
# scripts/generate-sdk-facade.ts
packages/sdk/index.ts linguist-generated
packages/sdk/browser.ts linguist-generated
packages/sdk/node.mts linguist-generated
packages/sdk/common/** linguist-generated
packages/sdk/browser/** linguist-generated
# The records of scripts/check-english.ts and scripts/check-translations.ts (`--write`)
scripts/english-baseline.json linguist-generated
site/content/i18n/translation-sources.json linguist-generated
# The translations of the generated API reference
site/content/reference/api.*.json linguist-generated
# The report data bench/runner/publishReport.ts copies from a campaign; its site modules stay counted
site/reports/*/report.json linguist-generated
site/reports/*/sources/** linguist-generated
# The format goldens: the compiler's output, rewritten by a `regenerate_*` test or on a format bump
tests/fixtures/formats/**/expected.json linguist-generated
# A generated scene source, as in .prettierignore
tests/fixtures/scenes/mountain-terrain/** linguist-generated
site/assets/gallery/signature-architecture/source/** linguist-generated
# Third-party models and textures the examples compile
site/assets/examples/*/source/** linguist-vendored
