{
  "name": "web-geometry",
  "version": "0.2.0",
  "packageManager": "pnpm@11.16.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "license": "PolyForm-Noncommercial-1.0.0",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/sdk/browser.d.ts",
        "import": "./dist/sdk/browser.js"
      },
      "node": {
        "types": "./dist/sdk/node.d.mts",
        "import": "./dist/sdk/node.mjs"
      },
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js",
      "default": "./dist/sdk/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "web-geometry-compile": "./dist/sdk-node/src/cli/cli.mjs"
  },
  "files": [
    "dist",
    "!dist/site",
    "README.md",
    "docs/SDK.md",
    "LICENSE",
    "packages/README.md"
  ],
  "scripts": {
    "pnpm:devPreinstall": "node scripts/setup-development.ts",
    "build": "tsc -p tsconfig.json && node scripts/rewrite-dts-extensions.ts && node scripts/copy-resources.ts && node scripts/write-build-provenance.ts",
    "build:native": "cargo build --release --locked --manifest-path packages/asset-compiler-rust/Cargo.toml",
    "build:oracle": "cargo build --release --locked --features oracle --bin web-geometry-oracle --manifest-path packages/asset-compiler-rust/Cargo.toml",
    "build:wasm": "node scripts/build-wasm.ts",
    "test": "node scripts/test-unit.ts",
    "test:changed": "node scripts/check-changed.ts --tests-only",
    "test:gpu": "node tests/browser/test-gpu.ts",
    "check:changed": "node scripts/check-changed.ts",
    "test:watch": "node --experimental-strip-types --test --watch \"packages/*/src/**/*.test.ts\" \"tests/integration/*.test.ts\"",
    "test:native": "cargo test --release --locked --manifest-path packages/asset-compiler-rust/Cargo.toml",
    "bench:native": "cargo test --release --locked --manifest-path packages/asset-compiler-rust/Cargo.toml -- --ignored --nocapture compute_bench",
    "bench:native:g": "cargo test --release --locked --manifest-path packages/asset-compiler-rust/Cargo.toml -- --ignored --nocapture compute_bench_g",
    "lint": "pnpm run lint:js && pnpm run lint:native",
    "lint:js": "eslint .",
    "lint:native": "cargo clippy --release --locked --manifest-path packages/asset-compiler-rust/Cargo.toml --all-targets --all-features -- -D warnings && cargo clippy --release --locked --manifest-path packages/page-codec-wasm/Cargo.toml --all-targets -- -D warnings",
    "format": "prettier --ignore-path .gitignore --ignore-path .prettierignore --write \"**/*.{ts,mts,tsx,json}\" && cargo fmt --all --manifest-path packages/asset-compiler-rust/Cargo.toml && cargo fmt --all --manifest-path packages/page-codec-wasm/Cargo.toml",
    "format:check": "prettier --ignore-path .gitignore --ignore-path .prettierignore --check \"**/*.{ts,mts,tsx,json}\" && cargo fmt --all --manifest-path packages/asset-compiler-rust/Cargo.toml -- --check && cargo fmt --all --manifest-path packages/page-codec-wasm/Cargo.toml -- --check",
    "check:lines": "node scripts/check-file-lines.ts",
    "check:duplicates": "jscpd packages scripts tests bench site --format typescript,rust --min-lines 12 --min-tokens 100 --reporters console --exit-code 1 --no-tips",
    "check:unused": "knip",
    "validate": "node scripts/validate.ts",
    "check:structure": "node --test tests/integration/depot-autonome.test.ts tests/integration/structure-moteur.test.ts tests/integration/moteur-sans-three.test.ts tests/integration/moteur-sans-three-math.test.ts && tsc -p tsconfig.core.json --noEmit",
    "check:links": "node scripts/check-links.ts",
    "check:dts": "node scripts/rewrite-dts-extensions.ts --check",
    "check:no-js": "node scripts/check-no-js.ts",
    "check:docs-bundles": "node scripts/docs-build.ts --untracked",
    "check:site-types": "tsc -p tsconfig.site.json --noEmit",
    "check:tools-types": "tsc -p tsconfig.tools.json --noEmit",
    "proof:package": "node scripts/prove-installed-package.ts",
    "perf:browser": "node --experimental-strip-types --test --test-concurrency=1 bench/perf/browser/*.perf.ts",
    "perf:core": "node --experimental-strip-types --test --test-concurrency=1 bench/perf/core/*.perf.ts",
    "perf:all": "node --experimental-strip-types --test --test-concurrency=1 bench/perf/*/*.perf.ts && node bench/runner/perf/agrege.ts",
    "perf:baseline": "node --experimental-strip-types --test --test-concurrency=1 bench/perf/*/*.perf.ts && node bench/runner/perf/baseline-save.ts",
    "build:docs": "node scripts/docs-build.ts",
    "docs:scene": "node scripts/docs-scene.ts",
    "docs:serve": "node scripts/docs-serve.ts",
    "check:local": "node scripts/check-local-files.ts"
  },
  "jscpd": {
    "ignore": [
      "bench/perf/**",
      "bench/oracles/**",
      "bench/core/**",
      "site/assets/**"
    ]
  },
  "peerDependencies": {
    "three": "^0.174.0"
  },
  "dependencies": {
    "meshoptimizer": "~0.18.1"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "^1.2.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.174.0",
    "@webgpu/types": "^0.1.72",
    "codemirror": "^6.0.2",
    "daisyui": "^5.7.42",
    "esbuild": "^0.25.12",
    "eslint": "^10.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "highlight.js": "^11.12.0",
    "jscpd": "^5.2.0",
    "knip": "^6.35.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.174.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
