{
  "name": "trillion3d",
  "version": "1.0.0",
  "description": "Virtualized geometry and real-time rendering for the web: GPU-driven cluster culling, streaming under a fixed memory budget, temporal antialiasing and dynamic lighting.",
  "keywords": [
    "3d",
    "webgpu",
    "rendering",
    "virtualized-geometry",
    "lod",
    "streaming",
    "gltf",
    "engine",
    "physics"
  ],
  "homepage": "https://github.com/pasquelin/Trillion3D#readme",
  "bugs": "https://github.com/pasquelin/Trillion3D/issues",
  "packageManager": "pnpm@11.16.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "main": "./dist/sdk/index.js",
  "types": "./dist/sdk/index.d.ts",
  "unpkg": "./dist/trillion3d.module.js",
  "jsdelivr": "./dist/trillion3d.module.js",
  "license": "PolyForm-Noncommercial-1.0.0",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/sdk/browser.d.ts",
        "import": "./dist/sdk/browser.js"
      },
      "node": {
        "types": "./dist/sdk/node.d.mts",
        "import": "./dist/sdk/node.mjs"
      },
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js",
      "default": "./dist/sdk/index.js"
    },
    "./module": {
      "types": "./dist/sdk/browser.d.ts",
      "default": "./dist/trillion3d.module.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "trillion3d-compile": "./dist/sdk-node/src/cli/cli.mjs"
  },
  "files": [
    "dist",
    "!dist/witnesses",
    "!dist/*.sources.json",
    "README.md",
    "docs/SDK.md",
    "docs/MATHS.md",
    "docs/PHYSICS.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "packages/README.md"
  ],
  "scripts": {
    "audit:assets": "node scripts/audit-asset-licenses.ts",
    "skills:link": "node scripts/skills-link.ts",
    "pnpm:devPreinstall": "node scripts/setup-development.ts",
    "build": "node scripts/build.ts",
    "build:native": "node scripts/heavy-step.ts build:native cargo build --release --locked --all-features --manifest-path packages/asset-compiler-rust/Cargo.toml",
    "build:wasm": "node scripts/build-wasm.ts",
    "build:physics": "node scripts/build-physics-wasm.ts",
    "bench:gpu": "node bench/dawn/run.ts",
    "bench:gpu:suite": "node bench/dawn/suite.ts",
    "bench:physics": "node bench/physics/bodies.ts",
    "test": "node scripts/test-unit.ts",
    "test:mutation": "node scripts/test-mutation.ts",
    "test:gpu": "node bench/dawn/proofs.ts",
    "test:chrome": "node bench/dawn/proofs.ts --chrome",
    "check:changed": "node scripts/check-changed.ts",
    "test:native": "node scripts/native.ts test",
    "golden:write": "node scripts/native.ts golden",
    "lint": "pnpm run lint:js && pnpm run lint:native",
    "lint:js": "eslint .",
    "lint:native": "node scripts/native.ts lint",
    "format": "prettier --ignore-path .gitignore --ignore-path .prettierignore --write \"**/*.{ts,mts,json}\" && node scripts/native.ts fmt",
    "format:check": "prettier --ignore-path .gitignore --ignore-path .prettierignore --check \"**/*.{ts,mts,json}\" && node scripts/native.ts fmt-check",
    "check:lines": "node scripts/check-file-lines.ts",
    "check:cohesion": "node scripts/check-cohesion.ts",
    "check:cycles": "node --experimental-strip-types scripts/check-cycles.ts",
    "check:duplicates": "jscpd packages scripts tests bench --format typescript,rust --no-tips",
    "check:helpers": "node scripts/check-helpers.ts",
    "check:wgsl-library": "node scripts/check-wgsl-library.ts",
    "check:unused": "node scripts/check-unused.ts",
    "validate": "node scripts/validate.ts",
    "check:structure": "tsc -p tsconfig.core.json --noEmit",
    "check:types:browser": "tsc -p tsconfig.browser.json --noEmit",
    "check:sdk-facade": "node scripts/generate-sdk-facade.ts --check",
    "generate:shared-rules": "node scripts/generate-shared-rules.ts",
    "check:shared-rules": "node scripts/generate-shared-rules.ts --check",
    "compile:caches": "node scripts/scene-caches.ts",
    "check:english": "node scripts/check-english.ts",
    "check:bundle-size": "node scripts/check-bundle-size.ts",
    "check:dts": "node scripts/rewrite-dts-extensions.ts --check",
    "check:no-js": "node scripts/check-no-js.ts",
    "check:webgpu-only": "node scripts/check-webgpu-only.ts",
    "check:tools-types": "tsc -p tsconfig.tools.json --noEmit",
    "proof:package": "node scripts/prove-installed-package.ts",
    "perf:core": "node --experimental-strip-types --test --test-concurrency=1 bench/perf/core/*.perf.ts",
    "perf:all": "node --experimental-strip-types --test --test-concurrency=1 bench/perf/*/*.perf.ts && node bench/runner/perf/aggregate.ts",
    "perf:baseline": "node --experimental-strip-types --test --test-concurrency=1 bench/perf/*/*.perf.ts && node bench/runner/perf/baseline-save.ts",
    "check:local": "node scripts/check-local-files.ts",
    "fixtures:garden": "node scripts/fixtures/garden.ts"
  },
  "jscpd": {
    "minLines": 8,
    "minTokens": 64,
    "reporters": [
      "console"
    ],
    "exitCode": 1,
    "ignore": [
      "packages/math/src/batch/**",
      "**/*Before.fixture.ts"
    ]
  },
  "optionalDependencies": {
    "@trillion3d/compiler-darwin-arm64": "workspace:*",
    "@trillion3d/compiler-darwin-x64": "workspace:*",
    "@trillion3d/compiler-linux-arm64": "workspace:*",
    "@trillion3d/compiler-linux-x64": "workspace:*",
    "@trillion3d/compiler-win32-x64": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/tap-runner": "^10.0.0",
    "@types/node": "^22.20.2",
    "@types/three": "^0.174.0",
    "@webgpu/types": "^0.1.72",
    "ajv": "^8.20.0",
    "esbuild": "^0.25.12",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jscpd": "^5.2.0",
    "knip": "^6.35.1",
    "meshoptimizer": "~0.18.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "three": "^0.174.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.70.0",
    "webgpu": "0.6.2"
  },
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pasquelin/Trillion3D.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
