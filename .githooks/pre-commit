#!/bin/sh
. "$(dirname "$0")/lib.sh"
# symbolic-ref names the branch even before its first commit; it prints nothing when detached
# (rebase, bisect, cherry-pick in progress), which is allowed.
branch=$(git symbolic-ref --short -q HEAD)
if [ -n "$branch" ] && ! printf '%s' "$branch" | grep -Eq '^[0-9]+-'; then
  refuse "commits belong on a branch named <issue>-<short-name>, cut from develop for one GitHub issue."
fi
run_local_hook pre-commit "$@"
