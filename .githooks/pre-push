#!/bin/sh
# stdin: <local ref> <local sha> <remote ref> <remote sha>, one line per ref being pushed.
. "$(dirname "$0")/lib.sh"
refs=$(cat)
printf '%s\n' "$refs" | while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "${remote_ref#refs/heads/}" in
    develop|main) refuse "no push to '${remote_ref#refs/heads/}': open a pull request instead." ;;
  esac
done || exit 1
printf '%s\n' "$refs" | run_local_hook pre-push "$@"
