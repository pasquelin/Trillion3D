# Worktrees, agents' logs and throwaway files live inside the project, never beside it (#452):
# `.worktrees/<branch>/` for each tree, `.worktrees/logs/` for logs and scratch files.
/.worktrees
# Personal files stay local. Shared checks read these patterns. No entry ends with a slash: a
# pattern that does matches directories alone, and a linked worktree carries these as symbolic
# links (scripts/git/local-files.ts), which git would then see as files to track.
# Local files begin
.claude
.codex
.agents
.grok
AGENTS.local.md
AGENTS.override.md
CLAUDE.md
CLAUDE.local.md
CODEX.md
CODEX.local.md
GROK.md
GROK.local.md
RTK.md
.graphifyignore
graphify-out
/scripts/graphify-communautes.json
/scripts/graphify-libelles.mjs
/scripts/graphify-libelles.test.mjs
# Local files end

# The light and shadow step tables, assembled by .mesure/tables/verif/assemble.py: kept out of the repository.
/docs/ETAPES-LUMIERE-OMBRE.md

# Local test assets (see docs/COMPILER.md, "Input formats")
tests/assets/
# Compiled from their sources by `pnpm run compile:caches` and the test runners.
tests/fixtures/scenes/*/cache/

# The compiler binary a platform package ships, copied in by `scripts/native/compiler-dist.ts` (#1352).
packages/compiler/*/bin

